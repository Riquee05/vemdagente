# Navegador: apenas configurações publicáveis
VITE_SUPABASE_URL=https://example.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
VITE_SUPABASE_PROJECT_ID=example-project
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=example-browser-key
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=example-tracking-id

# Servidor: configure como variáveis seguras, nunca no navegador
SUPABASE_URL=https://example.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
SUPABASE_SERVICE_ROLE_KEY=configure-in-secure-storage
GEMINI_API_KEY=configure-in-secure-storage
GOOGLE_MAPS_API_KEY=configure-through-connector
GOOGLE_MAPS_BROWSER_KEY=configure-through-connector
LOVABLE_API_KEY=managed-by-lovable
RATE_LIMIT_HASH_SECRET=generate-a-random-secret

# Limites opcionais
RATE_LIMIT_HELP_MAX=5
RATE_LIMIT_HELP_WINDOW_SECONDS=3600
RATE_LIMIT_VOLUNTEER_MAX=3
RATE_LIMIT_VOLUNTEER_WINDOW_SECONDS=86400
RATE_LIMIT_ASSISTANT_MAX=20
RATE_LIMIT_ASSISTANT_WINDOW_SECONDS=600